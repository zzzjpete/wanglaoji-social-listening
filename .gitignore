__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/

# 模型权重与缓存（transformers / torch / jieba）
.cache/
*.pt
*.pth
*.safetensors
*.bin
jieba.cache

